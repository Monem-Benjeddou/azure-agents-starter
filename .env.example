# Copy to .env and fill in. Empty values count as unset.
# Leave an *_API_KEY empty to use Microsoft Entra ID (DefaultAzureCredential).

# Models: azure_openai | openai_compatible
LLM_PROVIDER=azure_openai
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# OpenAI-compatible servers (Ollama, vLLM, LM Studio, llama.cpp)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=

# Index: memory | azure_search
INDEX_PROVIDER=memory
MEMORY_INDEX_PATH=.data/index.json

AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=knowledge

# Search an index owned by another system, read-only
AZURE_SEARCH_EXISTING_INDEX=false
AZURE_SEARCH_SOURCE_FIELD=id
AZURE_SEARCH_CONTENT_FIELD=content
AZURE_SEARCH_VECTOR_FIELD=content_vector

# Agents: local | foundry
AGENT_RUNTIME=local
MAX_TURNS=8

FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_IDS=
FOUNDRY_MODEL=
FOUNDRY_SEARCH_CONNECTION_ID=
FOUNDRY_AGENT_PREFIX=agents-starter-
FOUNDRY_RUN_TIMEOUT_SECONDS=300

# HTTP: require an X-API-Key header on every route except /health
API_KEY=
